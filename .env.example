# ─── Agentic Drift Detector — Environment Configuration ──────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ── PostgreSQL (Tier 1 SaaS) ──────────────────────────────────────────────────
# Leave blank to use SQLite fallback (local development default).
# Docker Compose default:
DATABASE_URL=postgresql://drift:drift@localhost:5432/drift

# ── Redis (Tier 1 SaaS) ───────────────────────────────────────────────────────
# Leave blank to write synchronously (no queue, no worker needed).
# Docker Compose default:
REDIS_URL=redis://localhost:6379/0

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# Identifies which tenant owns the data for this deployment.
# Defaults to "default" if not set.
TENANT_ID=my-company

# ── LLM Integration (optional) ────────────────────────────────────────────────
# If unset, the workflow runs in simulation mode (no API calls).
OPENAI_API_KEY=sk-...

# ── Webhook Alerting (optional) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
